# OjekAI — Firebase config (copy this file to `.env` and fill it in)
#
# These values come from your Firebase project: Firebase console >
# Project settings > Your apps > Web app. They are public client
# identifiers, NOT secrets — but keep them in `.env` (git-ignored) so the
# repo stays project-agnostic. See FIREBASE_SETUP.md for the exact steps.
#
# Without these values the app runs in clearly-labelled DEMO mode.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional: reCAPTCHA v3 site key for Firebase App Check.
# Only needed once App Check enforcement is turned on in the console
# (the AI Logic guided setup turns it on automatically).
VITE_FIREBASE_RECAPTCHA_SITE_KEY=
